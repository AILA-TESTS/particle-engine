{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "",
        "command": ".claude/hooks/memory-guard.sh"
      },
      {
        "matcher": "",
        "command": ".claude/hooks/context-monitor.sh \"$TRANSCRIPT_PATH\" \"$SESSION_ID\""
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "command": ".claude/hooks/memory-guard.sh"
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "command": ".claude/hooks/memory-guard.sh"
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "command": ".claude/hooks/pre-compact-memory-save.sh \"$TRANSCRIPT_PATH\" \"$SESSION_ID\""
      }
    ]
  }
}
